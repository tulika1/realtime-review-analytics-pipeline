{
  // GitHub Codespaces / VS Code Dev Containers: the full Docker stack in the cloud,
  // nothing installed on your own machine. Then run: docker compose up -d --build
  "name": "ReviewLens",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [8080, 8501],
  "portsAttributes": {
    "8080": { "label": "Airflow", "onAutoForward": "notify" },
    "8501": { "label": "Dashboard", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install -e '.[dev,stream]' && pytest -q --ignore=tests/spark",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
